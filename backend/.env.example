# ==============================================================================
# Tea Time Cafe — Backend Environment Configuration
# ==============================================================================

# Database Connection URL (SQLite default or PostgreSQL for production)
# SQLite: sqlite:///./teatime.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/teatime_db
DATABASE_URL=sqlite:///./teatime.db

# JWT Authentication Secret Key & Algorithm
SECRET_KEY=teatime_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Test Mode Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_tea_time_cafe_key
RAZORPAY_KEY_SECRET=rzp_test_tea_time_cafe_secret

# Frontend Application Origin (for CORS & Table QR Encoding)
FRONTEND_URL=http://localhost:3000

# Server Environment Mode (development | production)
ENV_MODE=development
